{
  "version": 1,
  "providers": [
    {
      "id": "gmail",
      "domains": ["gmail.com", "googlemail.com"],
      "displayName": { "zh": "Gmail", "en": "Gmail" },
      "imap": { "host": "imap.gmail.com", "port": 993, "tls": "tls" },
      "smtp": { "host": "smtp.gmail.com", "port": 465, "tls": "tls", "alt": { "port": 587, "tls": "starttls" } },
      "auth": {
        "type": "oauth2",
        "helpUrl": "https://imy.email",
        "authUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "clientIdEnv": "IMYEMAIL_CLOUD_GMAIL_CLIENT_ID",
        "redirectUri": "http://127.0.0.1:8743/oauth",
        "scopes": ["https://mail.google.com/"]
      },
      "quirks": ["gmail-labels", "sent-append"],
      "limits": { "attachmentMB": 25 },
      "capabilities": { "condstore": true, "idle": true }
    },
    {
      "id": "outlook",
