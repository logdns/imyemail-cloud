<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Chck.Mail</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>true</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Use the SDK's bundled PRI tasks even for an unpackaged application. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>imyemail-cloud-native</ApplicationTitle>
    <AssemblyName>imyemail-cloud</AssemblyName>
    <SatelliteResourceLanguages>en;en-US;zh;zh-Hans;zh-CN;zh-Hant;zh-TW;ja;ja-JP;es;es-ES;fr;fr-FR</SatelliteResourceLanguages>
    <Version>0.2.4</Version>
    <InformationalVersion>0.2.4</InformationalVersion>
    <ApplicationIcon>Assets\imyemail-cloud.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chck.Mail.Core\Chck.Mail.Core.csproj" />
    <ProjectReference Include="..\Chck.Mail.Design\Chck.Mail.Design.csproj" />
    <ProjectReference Include="..\Chck.Mail.MailKit\Chck.Mail.MailKit.csproj" />
    <ProjectReference Include="..\Chck.Mail.Sync\Chck.Mail.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\imyemail-cloud.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
